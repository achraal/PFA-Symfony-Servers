{% extends "base.html.twig" %}

{% block title %}Demande Congé{% endblock %}

{% block body %}

<style>
 /* Conteneur scroll horizontal si besoin */
.table-responsive {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  margin-bottom: 2rem;
}

/* Style global du tableau */
table.table {
  width: 100%;
  min-width: 1200px;
  border-collapse: separate;
  border-spacing: 0;
  font-family: 'Poppins', sans-serif;
  font-size: 0.95rem;
  color: #2c3e50; /* gris foncé pour le texte */
  background: #ffffff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  border: 1px solid #dddddd;
}

/* En-tête du tableau */
table.table thead tr {
  background-color: #1e3a5f; /* bleu nuit foncé */
  color: #f0f4f8; /* texte clair */
  text-transform: uppercase;
  font-weight: 700;
  font-size: 0.9rem;
  letter-spacing: 0.05em;
  border-bottom: 2px solid #4fc3f7; /* bleu clair */
}

table.table thead th {
  padding: 12px 16px;
  border: none;
  text-align: left;
  white-space: nowrap;
}

/* Lignes du corps avec alternance de couleurs */
table.table tbody tr:nth-child(odd) {
  background-color: #f7f9fc; /* gris très clair */
}

table.table tbody tr:nth-child(even) {
  background-color: #ffffff; /* blanc cassé */
}

/* Survol des lignes */
table.table tbody tr:hover {
  background-color: #81d4fa; /* bleu turquoise clair */
}

/* Cellules */
table.table tbody td {
  padding: 12px 16px;
  vertical-align: middle;
  border-bottom: 1px solid #eeeeee;
  color: #2c3e50;
  white-space: normal;
  overflow-wrap: anywhere;
  font-size: 0.95rem;
}

/* Alignements spécifiques */
table.table tbody td[data-label="Nom Complet"],
table.table tbody td[data-label="Email"],
table.table tbody td[data-label="Poste"] {
  text-align: left;
}

table.table tbody td[data-label="Salaire"] {
  text-align: right;
  font-variant-numeric: tabular-nums;
}

table.table tbody td[data-label="Date Embauche"],
table.table tbody td[data-label="Contrat ID"],
table.table tbody td[data-label="Modifier"],
table.table tbody td[data-label="Supprimer"] {
  text-align: center;
  vertical-align: middle;
}

/* Colonnes actions plus étroites */
table.table td[data-label="Modifier"],
table.table td[data-label="Supprimer"],
table.table th:last-child,
table.table th:nth-last-child(2) {
  width: 1%;
  min-width: 100px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Colonnes dates */
table.table td[data-label="Date Embauche"],
table.table th[data-label="Date Embauche"] {
  min-width: 120px;
  max-width: 160px;
  white-space: nowrap;
}

/* Colonnes Contrat ID */
table.table td[data-label="Contrat ID"],
table.table th[data-label="Contrat ID"] {
  max-width: 500px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 0.85rem;
  color: #555555;
}

/* Colonnes Email */
table.table td[data-label="Email"],
table.table th[data-label="Email"] {
  min-width: 200px;
  white-space: nowrap;
}

/* Boutons Modifier et Supprimer */
a.btn-modifier, button.btn-danger {
  padding: 7px 15px;
  font-weight: 600;
  font-size: 0.9rem;
  border-radius: 25px;
  border: none;
  cursor: pointer;
  transition: background-color 0.3s ease, box-shadow 0.3s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  text-decoration: none;
  user-select: none;
  min-width: 100px;
}

/* Bouton Modifier - bleu vif */
a.btn-modifier {
  background: #0288d1;
  color: #fff;
  box-shadow: 0 4px 10px rgba(2, 136, 209, 0.4);
}

a.btn-modifier:hover,
a.btn-modifier:focus {
  background: #01579b;
  box-shadow: 0 6px 18px rgba(1, 87, 155, 0.7);
  outline: none;
  text-decoration: none;
}

/* Bouton Supprimer - rouge vif */
button.btn-danger {
  background: #d32f2f;
  color: #fff;
  box-shadow: 0 4px 10px rgba(211, 47, 47, 0.6);
}

button.btn-danger:hover,
button.btn-danger:focus {
  background: #9a0007;
  box-shadow: 0 6px 18px rgba(154, 0, 7, 0.8);
  outline: none;
}

/* Alertes */
.alert {
  font-family: 'Poppins', sans-serif;
  font-weight: 600;
  font-size: 1rem;
  padding: 12px 20px;
  border-radius: 12px;
  margin-bottom: 1.5rem;
  max-width: 960px;
  margin-left: auto;
  margin-right: auto;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.alert-success {
  background-color: #d0f0d8;
  color: #2e7d32;
  border: 1px solid #81c784;
}

.alert-error, .alert-danger {
  background-color: #f9d6d5;
  color: #c62828;
  border: 1px solid #e57373;
}

/* Responsive */
@media (max-width: 900px) {
  .table-responsive {
    overflow-x: auto;
  }

  table.table {
    min-width: 700px;
    font-size: 0.9rem;
  }

  table.table thead {
    display: none;
  }

  table.table tbody tr {
    display: block;
    margin-bottom: 1.5rem;
    background: #fff;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    border-radius: 12px;
    padding: 1rem;
  }

  table.table tbody td {
    display: flex;
    justify-content: space-between;
    padding: 10px 15px;
    border-bottom: 1px solid #e0e0e0;
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
  }

  table.table tbody td:last-child {
    border-bottom: none;
  }

  table.table tbody td::before {
    content: attr(data-label);
    font-weight: 700;
    color: #1565c0;
    flex-basis: 40%;
    text-transform: uppercase;
  }

  /* Boutons en ligne */
  .card-body {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  a.btn-modifier, button.btn-danger {
    flex: 1 1 45%;
    min-width: 140px;
  }
}

</style>

{% for label, messages in app.flashes %}
  {% for message in messages %}
    <div class="alert alert-{{ label }}">
      {{ message }}
    </div>
  {% endfor %}
{% endfor %}

<div class="table-responsive">
  <table class="table table-striped table-hover" aria-label="Liste des demandes de congé">
    <thead>
      <tr>
        <th scope="col">Employé</th>
        <th scope="col">Type</th>
        <th scope="col">Début</th>
        <th scope="col">Fin</th>
        <th scope="col">Statut</th>
        <th scope="col">Motif</th>
        <th scope="col">Commentaire</th>
        <th scope="col"></th>
        <th scope="col"></th>
      </tr>
    </thead>
    <tbody>
      {% for demande in demandeConge %}
        <tr>
          <td data-label="Employé">
            {% if demande.employe %}
              {{ demande.employe.nom }} {{ demande.employe.prenom }}
            {% else %}
              -
            {% endif %}
          </td>
          <td data-label="Type Congé">{{ demande.typeConge }}</td>
          <td data-label="Date début">{{ demande.dateDebut ? demande.dateDebut|date('d/m/Y') : 'N/A' }}</td>
          <td data-label="Date fin">{{ demande.dateFin ? demande.dateFin|date('d/m/Y') : 'N/A' }}</td>
          <td data-label="Statut">{{ demande.statut }}</td>
          <td data-label="Motif">{{ demande.motif is not empty ? demande.motif : 'Aucun Motif' }}</td>
          <td data-label="Commentaire">{{ demande.commentaire is not empty ? demande.commentaire : 'Aucun Commentaire' }}</td>
          <td data-label="Modifier">
            <a href="{{ path('modifierDemandeConge', {'id': demande.id}) }}" class="btn-modifier" aria-label="Modifier demande de congé de {{ demande.employe.nom }} {{ demande.employe.prenom }}">Modifier</a>
          </td>
          <td data-label="Supprimer">
            <form method="post" action="{{ path('supprimerDemandeConge', {'id': demande.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette demande de congé ?');">
              <input type="hidden" name="_method" value="POST">
              <input type="hidden" name="_token" value="{{ csrf_token('delete_demande' ~ demande.id) }}">
              <button class="btn-danger" type="submit" aria-label="Supprimer demande de congé de {{ demande.employe.nom }} {{ demande.employe.prenom }}">Supprimer</button>
            </form>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="9" style="text-align:center; padding: 20px; color: #777;">Aucune demande de congé trouvée.</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

{% endblock %}

