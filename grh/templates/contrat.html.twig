{% extends "base.html.twig" %}

{% block title %}Contrats{% endblock %}

{% block body %}

<style>
  .table-responsive {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  margin-bottom: 2rem;
}

table.table {
  width: 100%;
  min-width: 900px;
  border-collapse: separate;
  border-spacing: 0;
  font-family: 'Poppins', sans-serif;
  font-size: 0.97rem;
  color: #34495e;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
}

/* En-tête bleu doux */
table.table thead tr {
  background: linear-gradient(135deg, #4a90e2, #357ABD);
  color: #e8f0fe;
  font-weight: 700;
  font-size: 0.95rem;
  letter-spacing: 0.05em;
}

table.table thead th {
  padding: 12px 16px;
  border: none;
  text-align: left;
  white-space: nowrap;
}

table.table tbody tr {
  background: #fafafa;
  transition: background-color 0.3s;
}

table.table tbody tr:hover {
  background-color: #d0e4ff; /* bleu très clair */
}

table.table tbody td {
  padding: 12px 16px;
  vertical-align: middle;
  border: none;
  color: #2c3e50;
  white-space: normal;
  overflow-wrap: anywhere;
  font-size: 0.97rem;
}

/* Colonnes actions */
table.table td[data-label="Modifier"],
table.table td[data-label="Supprimer"],
table.table th:last-child,
table.table th:nth-last-child(2) {
  width: 1%;
  min-width: 100px;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Colonnes dates */
table.table td[data-label="Date début"],
table.table td[data-label="Date fin"],
table.table th[data-label="Date début"],
table.table th[data-label="Date fin"] {
  min-width: 105px;
  max-width: 140px;
  white-space: nowrap;
}

/* Colonnes texte long */
table.table td[data-label="Avantages Sociaux"],
table.table th[data-label="Avantages Sociaux"] {
  min-width: 120px;
  max-width: 250px;
}

/* Boutons */
a.btn-modifier, button.btn-danger, a.btn-retour {
  padding: 7px 15px;
  font-weight: 600;
  font-size: 0.92rem;
  border-radius: 25px;
  border: none;
  cursor: pointer;
  transition: background 0.3s, box-shadow 0.3s;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  text-decoration: none;
  user-select: none;
}

/* Bouton Modifier et bouton Retour - bleu-vert */
a.btn-modifier, a.btn-retour, .btn.btn-modifier {
  background: linear-gradient(135deg, #3a9d9d, #2a7f7f);
  color: #e8f5f5 !important;
  box-shadow: 0 6px 15px rgba(42, 127, 127, 0.4);
}

a.btn-modifier:hover,
a.btn-modifier:focus,
a.btn-retour:hover,
a.btn-retour:focus,
.btn.btn-modifier:hover,
.btn.btn-modifier:focus {
  background: linear-gradient(135deg, #2a7f7f, #1b5f5f);
  box-shadow: 0 8px 25px rgba(27, 95, 95, 0.7);
  outline: none;
  text-decoration: none;
  color: #e8f5f5 !important;
}

/* Bouton Supprimer */
button.btn-danger {
  background: linear-gradient(135deg, #e57373, #c62828);
  color: #fff;
  box-shadow: 0 6px 15px rgba(198, 40, 40, 0.4);
  border: none;
}

button.btn-danger:hover,
button.btn-danger:focus {
  background: linear-gradient(135deg, #c62828, #8e0000);
  box-shadow: 0 8px 25px rgba(142, 0, 0, 0.25);
  outline: none;
}

/* Alertes */
.alert {
  font-family: 'Poppins', sans-serif;
  font-weight: 600;
  font-size: 1rem;
  padding: 12px 20px;
  border-radius: 12px;
  margin-bottom: 1.5rem;
  max-width: 960px;
  margin-left: auto;
  margin-right: auto;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.alert-success {
  background-color: #d0f0d8;
  color: #2e7d32;
  border: 1px solid #81c784;
}

.alert-error, .alert-danger {
  background-color: #f9d6d5;
  color: #c62828;
  border: 1px solid #e57373;
}

/* Historique : container cartes */
.historique-container {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem;
  margin-top: 1rem;
  margin-bottom: 3rem;
}

.historique-card {
  background: #ffffff;
  border-radius: 15px;
  box-shadow: 0 6px 20px rgba(0, 121, 107, 0.1);
  padding: 1.5rem 1.8rem;
  flex: 1 1 300px;
  font-family: 'Poppins', sans-serif;
  color: #2c3e50;
  transition: box-shadow 0.3s, transform 0.3s;
}

.historique-card:hover {
  box-shadow: 0 12px 30px rgba(0, 121, 107, 0.3);
  transform: translateY(-6px);
}

.historique-card h3 {
  font-size: 1.15rem;
  color: #00796b;
  margin-bottom: 0.7rem;
  font-weight: 700;
}

.historique-card p {
  margin: 0.25rem 0;
  font-size: 0.98rem;
}

/* Responsive : scroll horizontal sur mobile */
@media (max-width: 900px) {
  table.table {
    min-width: 700px;
    font-size: 0.93rem;
  }
  .historique-container {
    flex-direction: column;
  }
  .historique-card {
    min-width: 0;
    width: 100%;
  }
}

</style>


{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }}">
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}

<h1>Liste des contrats</h1>

{% for item in contratsAvecHistorique %}
    {% set contrat = item.contrat %}
    {% set historique = item.historique %}

    <div class="table-responsive">
      <table class="table table-striped table-hover mb-5">
          <thead>
              <tr>
                  {# <th scope="col">ID</th> #}
                  <th scope="col">Employé</th>
                  <th scope="col">Type</th>
                  <th scope="col">Début</th>
                  <th scope="col">Fin</th>
                  <th scope="col">Salaire</th>
                  <th scope="col">Avantages Sociaux</th>
                  <th scope="col"></th>
                  <th scope="col"></th>
              </tr>
          </thead>
          <tbody>
              <tr>
                  {# <td data-label="ID">{{ contrat.id }}</td> #}
                  <td data-label="Employé">{{ contrat.employe.nom }}</td>
                  <td data-label="Type">{{ contrat.type }}</td>
                  <td data-label="Date début">{{ contrat.dateDebut|default('N/A') }}</td>
                  <td data-label="Date fin">{{ contrat.dateFin|default('N/A') }}</td>
                  <td data-label="Salaire">{{ contrat.salaire }}</td>
                  <td data-label="Avantages Sociaux">{{ contrat.avantagesSociaux }}</td>
                  <td data-label="Modifier">
                      <a href="{{ path('modifierContrat', {'id': contrat.id}) }}" class="btn-modifier">Modifier</a>
                  </td>
                  <td data-label="Supprimer">
                      <form method="post" action="{{ path('supprimerContrat', {'id': contrat.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce contrat ?');">
                          <input type="hidden" name="_method" value="POST">
                          <input type="hidden" name="_token" value="{{ csrf_token('delete_contrat' ~ contrat.id) }}">
                          <button class="btn-danger" type="submit">Supprimer</button>
                      </form>
                  </td>
              </tr>
          </tbody>
      </table>
    </div>

    <h2>Historique des modifications</h2>
    {% if historique is not empty %}
        <div class="historique-container">
            {% for modification in historique %}
                <div class="historique-card">
                    <h3>Modification du {{ modification.dateModification|default('N/A') }}</h3>
                    <p><strong>Type:</strong> {{ modification.type|default('N/A') }}</p>
                    <p><strong>Date début:</strong> {{ modification.dateDebut|default('N/A') }}</p>
                    <p><strong>Date fin:</strong> {{ modification.dateFin|default('N/A') }}</p>
                    <p><strong>Salaire:</strong> {{ modification.salaire|default('N/A') }}</p>
                    <p><strong>Avantages Sociaux:</strong> {{ modification.avantagesSociaux|default('N/A') }}</p>
                    <p><strong>Employé:</strong> {{ modification.employe|default('N/A') }}</p>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <p>Aucun historique disponible.</p>
    {% endif %}
{% endfor %}

<a href="{{ path('contrat') }}" class="btn btn-modifier">Retour à la liste des contrats</a>

{% endblock %}
