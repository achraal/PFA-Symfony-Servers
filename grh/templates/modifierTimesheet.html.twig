{% extends "base.html.twig" %}
{% block title %}Modification Timesheet{% endblock %}

{% block body %}

<style>
  form {
    max-width: 520px;
    margin: 2rem auto;
    padding: 2rem 2.5rem;
    background: #f9f9f9;
    border-radius: 15px;
    box-shadow: 0 10px 25px rgba(0, 121, 107, 0.1);
    font-family: 'Poppins', sans-serif;
  }

  form label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
    color: #004d40;
    font-size: 1rem;
  }

  form input[type="date"],
  form input[type="number"],
  form select,
  form textarea {
    width: 100%;
    padding: 10px 14px;
    margin-bottom: 1.5rem;
    border: 2px solid #b2dfdb;
    border-radius: 12px;
    font-size: 1rem;
    transition: border-color 0.3s ease;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
  }

  form input[type="date"]:focus,
  form input[type="number"]:focus,
  form select:focus,
  form textarea:focus {
    border-color: #00796b;
    outline: none;
  }

  textarea {
    resize: vertical;
    min-height: 80px;
  }

  input[type="submit"] {
    background: linear-gradient(135deg, #4caf50, #2e7d32);
    color: #e8f5e9;
    font-weight: 700;
    font-size: 1.1rem;
    padding: 12px 25px;
    border: none;
    border-radius: 30px;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(46, 125, 50, 0.4);
    transition: background 0.3s ease, transform 0.2s ease;
    width: 100%;
  }

  input[type="submit"]:hover,
  input[type="submit"]:focus {
    background: linear-gradient(135deg, #2e7d32, #1b5e20);
    transform: translateY(-3px);
    outline: none;
  }

  /* Responsive */
  @media (max-width: 540px) {
    form {
      padding: 1.5rem 1.8rem;
      margin: 1rem;
    }
  }
  button[type="submit"],
a.btn-secondary {
  display: inline-block;
  padding: 10px 25px;
  font-weight: 700;
  font-size: 1rem;
  border-radius: 30px;
  cursor: pointer;
  text-align: center;
  text-decoration: none;
  user-select: none;
  transition: background 0.3s ease, box-shadow 0.3s ease;
  border: none;
  font-family: 'Poppins', sans-serif;
}

button[type="submit"] {
  background: linear-gradient(135deg, #4caf50, #2e7d32);
  color: #e8f5e9;
  box-shadow: 0 6px 20px rgba(46, 125, 50, 0.4);
  margin-right: 1rem;
}

a.btn-secondary {
  background: #ccc;
  color: #333;
  padding-top: 11px;
  padding-bottom: 11px;
}

a.btn-secondary:hover,
a.btn-secondary:focus {
  background: #999;
  color: #fff;
  outline: none;
}


</style>

<form action="/modificationTimesheet" method="post" novalidate>
  <input type="hidden" name="id" value="{{ timesheet.id }}" required>

  <label for="date">Date :</label>
  <input type="date" id="date" name="date" value="{{ timesheet.date }}" required>

  <label for="heuresTravail">Heures Travail :</label>
  <input type="number" id="heuresTravail" name="heuresTravail" value="{{ timesheet.heuresTravail }}" min="0" step="0.01" required>

  <label for="heuresSup">Heures Sup :</label>
  <input type="number" id="heuresSup" name="heuresSup" value="{{ timesheet.heuresSup }}" min="0" step="0.01">

  <label for="motif">Motif Heures Sup (Facultatif) :</label>
  <textarea id="motif" name="motif" rows="4" placeholder="Votre commentaire...">{{ timesheet.motif }}</textarea>

  <label for="employe">Employé :</label>
  <select name="employe" id="employe" required>
      {% for e in employes %}
          <option value="{{ e.id }}" {% if e.id == timesheet.employe.id %}selected{% endif %}>{{ e.nom }} {{ e.prenom }}</option>
      {% endfor %}
  </select>

	<button type="submit">Valider</button>
    <a href="{{ path('timesheet') }}" class="btn-secondary">Annuler</a>
</form>

{% endblock %}
