{% extends "base.html.twig" %}
{% block title %}Ajout Timesheet{% endblock %}

{% block body %}

<style>
  form {
    max-width: 500px;
    margin: 2rem auto;
    padding: 2rem 2.5rem;
    background: #f9f9f9;
    border-radius: 15px;
    box-shadow: 0 10px 25px rgba(0, 121, 107, 0.1);
    font-family: 'Poppins', sans-serif;
  }

  form label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
    color: #004d40;
    font-size: 1rem;
  }

  form input[type="date"],
  form input[type="number"],
  form select,
  form textarea {
    width: 100%;
    padding: 10px 14px;
    margin-bottom: 1.5rem;
    border: 2px solid #b2dfdb;
    border-radius: 12px;
    font-size: 1rem;
    transition: border-color 0.3s ease;
    box-sizing: border-box;
    resize: vertical;
  }

  form input[type="date"]:focus,
  form input[type="number"]:focus,
  form select:focus,
  form textarea:focus {
    border-color: #00796b;
    outline: none;
  }

  form input[type="submit"] {
    background: linear-gradient(135deg, #4caf50, #2e7d32);
    color: #e8f5e9;
    font-weight: 700;
    font-size: 1.1rem;
    padding: 12px 25px;
    border: none;
    border-radius: 30px;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(46, 125, 50, 0.4);
    transition: background 0.3s ease, transform 0.2s ease;
    width: 100%;
  }

  form input[type="submit"]:hover,
  form input[type="submit"]:focus {
    background: linear-gradient(135deg, #2e7d32, #1b5e20);
    transform: translateY(-3px);
    outline: none;
  }

  /* Responsive */
  @media (max-width: 520px) {
    form {
      padding: 1.5rem 1.8rem;
      margin: 1rem;
    }
  }
</style>

<form action="ajouterTimesheet" method="post" novalidate>
  <label for="date">Date :</label>
  <input type="date" id="date" name="date" required>

  <label for="heuresTravail">Heures travail :</label>
  <input type="number" id="heuresTravail" name="heuresTravail" min="0" step="0.01" required>

  <label for="heuresSup">Heures Sup :</label>
  <input type="number" id="heuresSup" name="heuresSup" min="0" step="0.01">

  <label for="motif">Motif Heures Sup (Facultatif) :</label>
  <textarea id="motif" name="motif" rows="4" placeholder="Votre commentaire..."></textarea>

  <label for="employe">Employé :</label>
  <select name="employe" id="employe" required>
      {% for employe in employes %}
          <option value="{{ employe.id }}">{{ employe.nom }} {{ employe.prenom }}</option>
      {% endfor %}
  </select>

  <input type="submit" value="Valider">
</form>

{% endblock %}
