{% extends "base.html.twig" %}
{% block title %}Modification demande de congé{% endblock %}

{% block body %}

<style>
  h1 {
    text-align: center;
    color: #004d40;
    font-weight: 700;
    margin-bottom: 2rem;
    font-family: 'Poppins', sans-serif;
  }

  form {
    max-width: 600px;
    margin: 0 auto 3rem;
    padding: 2rem 2.5rem;
    background: #f9f9f9;
    border-radius: 15px;
    box-shadow: 0 10px 25px rgba(0, 121, 107, 0.1);
    font-family: 'Poppins', sans-serif;
  }

  .mb-3 {
    margin-bottom: 1.5rem;
  }

  label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
    color: #004d40;
    font-size: 1rem;
  }

  input[type="text"],
  input[type="date"],
  select,
  textarea {
    width: 100%;
    padding: 10px 14px;
    border: 2px solid #b2dfdb;
    border-radius: 12px;
    font-size: 1rem;
    transition: border-color 0.3s ease;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
  }

  input[type="text"]:focus,
  input[type="date"]:focus,
  select:focus,
  textarea:focus {
    border-color: #00796b;
    outline: none;
  }

  textarea {
    resize: vertical;
    min-height: 80px;
  }

  button[type="submit"],
  a.btn-secondary {
    display: inline-block;
    padding: 10px 25px;
    font-weight: 700;
    font-size: 1rem;
    border-radius: 30px;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    user-select: none;
    transition: background 0.3s ease, box-shadow 0.3s ease;
    border: none;
    font-family: 'Poppins', sans-serif;
  }

  button[type="submit"] {
    background: linear-gradient(135deg, #4caf50, #2e7d32);
    color: #e8f5e9;
    box-shadow: 0 6px 20px rgba(46, 125, 50, 0.4);
    margin-right: 1rem;
  }

  button[type="submit"]:hover,
  button[type="submit"]:focus {
    background: linear-gradient(135deg, #2e7d32, #1b5e20);
    box-shadow: 0 8px 25px rgba(27, 95, 32, 0.7);
    outline: none;
  }

  a.btn-secondary {
    background: #ccc;
    color: #333;
    padding-top: 11px;
    padding-bottom: 11px;
  }

  a.btn-secondary:hover,
  a.btn-secondary:focus {
    background: #999;
    color: #fff;
    outline: none;
  }

  /* Responsive */
  @media (max-width: 600px) {
    form {
      padding: 1.5rem 1.8rem;
      margin: 1rem;
    }

    button[type="submit"],
    a.btn-secondary {
      width: 100%;
      margin: 0 0 1rem 0;
      display: block;
      text-align: center;
    }
  }
</style>

<h1>Modifier une demande de congé</h1>

<form action="{{ path('modificationDemandeConge') }}" method="post" novalidate>
    <input type="hidden" name="id" value="{{ demandeConge.id }}">

    <div class="mb-3">
        <label for="typeConge">Type de Congé</label>
        <input type="text" id="typeConge" name="typeConge" value="{{ demandeConge.typeConge }}" required>
    </div>

    <div class="mb-3">
        <label for="dateDebut">Date début</label>
        <input type="date" id="dateDebut" name="dateDebut" value="{{ demandeConge.dateDebut }}" required>
    </div>

    <div class="mb-3">
        <label for="dateFin">Date fin</label>
        <input type="date" id="dateFin" name="dateFin" value="{{ demandeConge.dateFin }}">
    </div>

    <div class="mb-3">
        <label for="statut">Statut</label>
        <input type="text" id="statut" name="statut" value="{{ demandeConge.statut }}" required>
    </div>

    <div class="mb-3">
        <label for="motif">Motif du congé (facultatif)</label>
        <textarea id="motif" name="motif">{{ demandeConge.motif }}</textarea>
    </div>

    <div class="mb-3">
        <label for="commentaire">Commentaire (justification de la décision)</label>
        <textarea id="commentaire" name="commentaire">{{ demandeConge.commentaire }}</textarea>
    </div>

    <div class="mb-3">
        <label for="employe">Employé</label>
        <select name="employe" id="employe" required>
            {% for e in employes %}
                <option value="{{ e.id }}" {% if e.id == demandeConge.employe.id %}selected{% endif %}>
                    {{ e.nom }} {{ e.prenom }}
                </option>
            {% endfor %}
        </select>
    </div>

    <button type="submit">Valider</button>
    <a href="{{ path('demandeConge') }}" class="btn-secondary">Annuler</a>
</form>

{% endblock %}
