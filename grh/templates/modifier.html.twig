{% extends "base.html.twig" %}
{% block title %}Page de modification{% endblock %}

{% block body %}

<style>
  form {
    max-width: 480px;
    margin: 2rem auto;
    padding: 2rem 2.5rem;
    background: #f9f9f9;
    border-radius: 15px;
    box-shadow: 0 10px 25px rgba(0, 121, 107, 0.1);
    font-family: 'Poppins', sans-serif;
  }

  h6 {
    text-align: center;
    color: #004d40;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  form div {
    margin-bottom: 1.25rem;
  }

  form label {
    display: block;
    margin-bottom: 0.4rem;
    font-weight: 600;
    color: #004d40;
    font-size: 1rem;
  }

  form input[type="text"],
  form input[type="email"],
  form input[type="date"],
  form input[type="hidden"] {
    width: 100%;
    padding: 10px 14px;
    border: 2px solid #b2dfdb;
    border-radius: 12px;
    font-size: 1rem;
    transition: border-color 0.3s ease;
    box-sizing: border-box;
  }

  form input[type="text"]:focus,
  form input[type="email"]:focus,
  form input[type="date"]:focus {
    border-color: #00796b;
    outline: none;
  }

  button[type="submit"] {
    background: linear-gradient(135deg, #4caf50, #2e7d32);
    color: #e8f5e9;
    font-weight: 700;
    font-size: 1.1rem;
    padding: 12px 25px;
    border: none;
    border-radius: 30px;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(46, 125, 50, 0.4);
    transition: background 0.3s ease, transform 0.2s ease;
    width: 100%;
  }

  button[type="submit"]:hover,
  button[type="submit"]:focus {
    background: linear-gradient(135deg, #2e7d32, #1b5e20);
    transform: translateY(-3px);
    outline: none;
  }

  /* Responsive */
  @media (max-width: 500px) {
    form {
      padding: 1.5rem 1.8rem;
      margin: 1rem;
    }
  }
    button[type="submit"],
a.btn-secondary {
  display: inline-block;
  padding: 10px 25px;
  font-weight: 700;
  font-size: 1rem;
  border-radius: 30px;
  cursor: pointer;
  text-align: center;
  text-decoration: none;
  user-select: none;
  transition: background 0.3s ease, box-shadow 0.3s ease;
  border: none;
  font-family: 'Poppins', sans-serif;
}

button[type="submit"] {
  background: linear-gradient(135deg, #4caf50, #2e7d32);
  color: #e8f5e9;
  box-shadow: 0 6px 20px rgba(46, 125, 50, 0.4);
  margin-right: 1rem;
}

a.btn-secondary {
  background: #ccc;
  color: #333;
  padding-top: 11px;
  padding-bottom: 11px;
}

a.btn-secondary:hover,
a.btn-secondary:focus {
  background: #999;
  color: #fff;
  outline: none;
}
</style>

<h6>Modifier un employé</h6>

<form action="/modifierEmploye" method="post" novalidate>
  <input type="hidden" name="id" value="{{ employe.id }}" required>

  <div>
    <label for="nom">Nom :</label>
    <input type="text" id="nom" name="nom" value="{{ employe.nom }}" required>
  </div>

  <div>
    <label for="prenom">Prénom :</label>
    <input type="text" id="prenom" name="prenom" value="{{ employe.prenom }}">
  </div>

  <div>
    <label for="email">Email :</label>
    <input type="email" id="email" name="email" value="{{ employe.email }}" required>
  </div>

  <div>
    <label for="poste">Poste :</label>
    <input type="text" id="poste" name="poste" value="{{ employe.poste }}" required>
  </div>

  <div>
    <label for="salaire">Salaire :</label>
    <input type="text" id="salaire" name="salaire" pattern="^\d+(\.\d{1,2})?$" value="{{ employe.salaire }}" required>
  </div>

  <div>
    <label for="date">Date d'embauche :</label>
    <input type="date" id="date" name="date" value="{{ employe.dateEmbauche }}" required>
  </div>

  <div style="display: flex; justify-content: flex-start; gap: 1rem; margin-top: 1rem;">
    <button type="submit">Valider</button>
    <a href="{{ path('employe') }}" class="btn-secondary">Annuler</a>
  </div>
</form>

{% endblock %}
