<div class="py-5" style="height: 75vh; background: linear-gradient(rgba(117, 113, 113, 0.43), rgba(117, 113, 113, 0.43)), url('/images/rh2.png'); background-size: cover; background-position: center;">
    <div class="container">
      <header class="text-center mb-5">
