{% extends "base.html.twig" %}
{% block title %}Modification Contrat{% endblock %}

{% block body %}

<style>
  form {
    max-width: 480px;
    margin: 2rem auto;
    padding: 2rem 2.5rem;
    background: #f9f9f9;
    border-radius: 15px;
    box-shadow: 0 10px 25px rgba(0, 121, 107, 0.1);
    font-family: 'Poppins', sans-serif;
  }

  form label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
    color: #004d40;
    font-size: 1rem;
  }

  form input[type="text"],
  form input[type="date"],
  form select,
  form input[type="hidden"] {
    width: 100%;
    padding: 10px 14px;
    margin-bottom: 1.5rem;
    border: 2px solid #b2dfdb;
    border-radius: 12px;
    font-size: 1rem;
    transition: border-color 0.3s ease;
    box-sizing: border-box;
  }

  form input[type="text"]:focus,
  form input[type="date"]:focus,
  form select:focus {
    border-color: #00796b;
    outline: none;
  }

  form input[type="submit"] {
    background: linear-gradient(135deg, #4caf50, #2e7d32);
    color: #e8f5e9;
    font-weight: 700;
    font-size: 1.1rem;
    padding: 12px 25px;
    border: none;
    border-radius: 30px;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(46, 125, 50, 0.4);
    transition: background 0.3s ease, transform 0.2s ease;
    width: 100%;
  }

  form input[type="submit"]:hover,
  form input[type="submit"]:focus {
    background: linear-gradient(135deg, #2e7d32, #1b5e20);
    transform: translateY(-3px);
    outline: none;
  }

  /* Responsive */
  @media (max-width: 500px) {
    form {
      padding: 1.5rem 1.8rem;
      margin: 1rem;
    }
  }
  button[type="submit"],
a.btn-secondary {
  display: inline-block;
  padding: 10px 25px;
  font-weight: 700;
  font-size: 1rem;
  border-radius: 30px;
  cursor: pointer;
  text-align: center;
  text-decoration: none;
  user-select: none;
  transition: background 0.3s ease, box-shadow 0.3s ease;
  border: none;
  font-family: 'Poppins', sans-serif;
}

button[type="submit"] {
  background: linear-gradient(135deg, #4caf50, #2e7d32);
  color: #e8f5e9;
  box-shadow: 0 6px 20px rgba(46, 125, 50, 0.4);
  margin-right: 1rem;
}

a.btn-secondary {
  background: #ccc;
  color: #333;
  padding-top: 11px;
  padding-bottom: 11px;
}

a.btn-secondary:hover,
a.btn-secondary:focus {
  background: #999;
  color: #fff;
  outline: none;
}
</style>

<form action="/modificationContrat" method="post" novalidate>
  <input type="hidden" name="id" value="{{ contrat.id }}" required>

  <label for="type">Type :</label>
  <input type="text" id="type" name="type" value="{{ contrat.type }}" required>

  <label for="dateDebut">Date début :</label>
  <input type="date" id="dateDebut" name="dateDebut" value="{{ contrat.DateDebut }}" required>

  <label for="dateFin">Date fin :</label>
  <input type="date" id="dateFin" name="dateFin" value="{{ contrat.DateFin }}">

  <label for="salaire">Salaire :</label>
  <input type="text" id="salaire" name="salaire" pattern="^\d+(\.\d{1,2})?$" value="{{ contrat.salaire }}" required>

  <label for="AvantagesSociaux">Avantages Sociaux :</label>
  <input type="text" id="AvantagesSociaux" name="AvantagesSociaux" value="{{ contrat.AvantagesSociaux }}" required>

  <label for="employe">Employé :</label>
  <select name="employe" id="employe" required>
    {% for e in employes %}
      <option value="{{ e.id }}" {% if e.id == contrat.employe.id %}selected{% endif %}>{{ e.nom }} {{ e.prenom }}</option>
    {% endfor %}
  </select>

  <button type="submit">Valider</button>
    <a href="{{ path('contrat') }}" class="btn-secondary">Annuler</a>
</form>

{% endblock %}
